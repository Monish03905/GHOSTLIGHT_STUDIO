# Copy to .env and fill in what you use. The studio works without any of these:
# it falls back to its offline muse and the system voice.

# Scriptwriting / directing
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# Optional high-fidelity narration (voice.provider = openai | elevenlabs)
ELEVENLABS_API_KEY=

# Optional overrides
GHOSTLIGHT_CONFIG=config.yaml
FFMPEG_BIN=
FFPROBE_BIN=
